---
import { sucursales } from '../data/sucursales';
const telHref = (p: string) => 'tel:' + p.replace(/[^+\d]/g, '');
---
<section class="section section--dark" id="sucursales">
  <div class="container">
    <div class="reveal">
      <span class="kicker">Sucursales</span>
      <h2 class="section-title">Estamos cerca tuyo en toda la Patagonia</h2>
      <p class="section-lead">7 sucursales para acompañarte estés donde estés.</p>
    </div>
    <div class="branches reveal">
      <div class="branch-tabs" id="branchTabs">
        {sucursales.map((s, i) => (
          <button class={`branch-tab ${i === 0 ? 'active' : ''}`} data-i={i}>
            <strong>{s.city}</strong><span>{s.prov}</span>
          </button>
        ))}
      </div>
      <div id="branchPanels">
        {sucursales.map((s, i) => (
          <div class={`branch-panel ${i === 0 ? 'active' : ''}`} data-i={i}>
            <h3>{s.city}</h3>
            <div class="branch-rows">
              <div class="branch-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <div><strong>Dirección</strong><span>{s.addr}</span></div>
              </div>
              <div class="branch-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.8 2z"/></svg>
                <div><strong>Teléfono</strong><a href={telHref(s.phone)}>{s.phone}</a>{s.phone2 && <> · <a href={telHref(s.phone2)}>{s.phone2}</a></>}</div>
              </div>
              <div class="branch-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                <div><strong>Horarios</strong><span>{s.hours}</span></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const tabs = document.getElementById('branchTabs');
    const panels = document.getElementById('branchPanels');
    if (!tabs || !panels) return;
    tabs.addEventListener('click', (e) => {
      const btn = e.target.closest('.branch-tab'); if (!btn) return;
      const i = btn.dataset.i;
      tabs.querySelectorAll('.branch-tab').forEach((x) => x.classList.remove('active'));
      btn.classList.add('active');
      panels.querySelectorAll('.branch-panel').forEach((p) => p.classList.toggle('active', p.dataset.i === i));
    });
  })();
</script>
