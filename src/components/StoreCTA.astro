---
import { SITE } from '../config';
---
<section class="section section--light">
  <div class="container">
    <div class="store-cta reveal">
      <div class="store-cta__text">
        <span class="kicker">Tienda online</span>
        <h2>Descubrí nuestros productos en la tienda online</h2>
        <p>¡Comprá desde cualquier punto del país!</p>
      </div>
      <a href={SITE.storeUrl} target="_blank" rel="noopener" class="btn btn--ghost" style="border-color:#fff;color:#fff">
        Ir a la tienda
        <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>
