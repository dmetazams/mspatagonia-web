---
import { SITE } from '../config';
import { sucursales } from '../data/sucursales';
const year = new Date().getFullYear();
---
<footer class="footer" id="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="logo logo--footer"><img src="/assets/logo-ms-apilado-blanco.png" alt="MS Patagonia Argentina" class="logo__img logo__img--stacked" /></a>
        <div class="footer__badge">25 años</div>
        <p>Soluciones integrales en climatización, bombeo de líquidos y aire comprimido. Inspirados por una pasión por una Patagonia sustentable.</p>
        <div class="socials">
          <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg></a>
          <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.6 15.6 2.6 15.2 2.6 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1C2.6 9.9 2.6 10.3 2.6 12s0 2.1.1 3.3c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-3.3s0-2.1-.1-3.3c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8zm0 8.1a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.2-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0z"/></svg></a>
          <a href={SITE.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.3 18.3v-7H6v7h2.3zM7.1 10.3a1.3 1.3 0 1 0 0-2.7 1.3 1.3 0 0 0 0 2.7zm11.2 8v-3.8c0-2-.4-3.6-2.8-3.6-1.1 0-1.9.6-2.2 1.2v-1H11v7h2.3v-3.5c0-.9.2-1.8 1.3-1.8s1.3 1.1 1.3 1.9v3.4h2.4z"/></svg></a>
          <a href={SITE.social.youtube} target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24"><path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 4.8 12 4.8 12 4.8s-7 0-8.9.6A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.6 8.9.6 8.9.6s7 0 8.9-.6a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.5 31 31 0 0 0-.5-4.5zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z"/></svg></a>
        </div>
      </div>

      <div class="footer__col">
        <h4>Soluciones</h4>
        <ul>
          <li><a href="/soluciones/aire-comprimido">Aire comprimido</a></li>
          <li><a href="/soluciones/bombeo-de-liquido">Bombeo de líquidos</a></li>
          <li><a href="/soluciones/climatizacion">Climatización</a></li>
          <li><a href="/soluciones/electricas">Eléctricas</a></li>
          <li><a href="/soluciones/tratamiento-de-agua">Tratamiento de agua</a></li>
          <li><a href="/soluciones/servicios">Servicios</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Compañía</h4>
        <ul>
          <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
          <li><a href="/productos">Productos</a></li>
          <li><a href="/sectores">Sectores</a></li>
          <li><a href="/novedades">Novedades</a></li>
          <li><a href={SITE.storeUrl} target="_blank" rel="noopener">Tienda online</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Sucursales</h4>
        <div class="footer__branches">
          {sucursales.map((s) => (
            <div class="fb"><strong>{s.city}</strong> {s.phone}</div>
          ))}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} MS Patagonia. Todos los derechos reservados.</span>
      <span>Soluciones integrales en climatización, bombeo y aire comprimido.</span>
    </div>
  </div>
</footer>
