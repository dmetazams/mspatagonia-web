---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, CLIENTIFY, isClientifyTracking, isClientifyChat } from '../config';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const { title, description, active } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.shortName}` : `${SITE.name} — ${SITE.tagline}`;
const desc = description ?? SITE.description;
const tracking = isClientifyTracking();
const chat = isClientifyChat();
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#232323" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_AR" />
  <link rel="icon" type="image/png" href="/assets/logo-ms-color.png" />
  <link rel="apple-touch-icon" href="/assets/logo-ms-color.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />

  {/* ===== Clientify — script de seguimiento (se activa al cargar trackingId en src/config.ts) ===== */}
  {tracking && (
    <script type="text/javascript" is:inline set:html={`
      (function(c,l,i,e,n,t,y){c['ClientifyTrackingObject']=n;c[n]=c[n]||function(){
      (c[n].q=c[n].q||[]).push(arguments)};t=l.createElement(i);t.async=1;t.src=e;
      y=l.getElementsByTagName(i)[0];y.parentNode.insertBefore(t,y);
      })(window,document,'script','https://webapp.clientify.com/tracking/${CLIENTIFY.trackingId}.js','clientify');
    `} />
  )}
</head>
<body>
  <Header active={active} />
  <slot />
  <Footer />

  <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" class="wa-float" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24"><path d="M.5 23.5l1.6-5.9a11.4 11.4 0 1 1 4.3 4.2L.5 23.5zM6.7 20l.4.2a9.5 9.5 0 1 0-3.2-3.2l.2.4-1 3.5 3.6-.9zm11.4-5.2c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.1-.3.2-.5.1a7.8 7.8 0 0 1-2.3-1.4 8.6 8.6 0 0 1-1.6-2c-.2-.3 0-.4.1-.6l.4-.4.3-.4v-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3a2.6 2.6 0 0 0-.8 1.9c0 1.1.8 2.2 1 2.4.1.1 1.6 2.5 4 3.5.5.2 1 .4 1.3.5.6.2 1.1.1 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.3z"/></svg>
  </a>

  {/* ===== Clientify — chat en vivo / inbox (se activa al cargar chatWidgetId en src/config.ts) ===== */}
  {chat && (
    <script type="text/javascript" is:inline async src={`https://webchat.clientify.net/widget/${CLIENTIFY.chatWidgetId}.js`}></script>
  )}

  <script is:inline>
    // Header scroll
    const header = document.getElementById('header');
    const onScroll = () => header && header.classList.toggle('scrolled', window.scrollY > 30);
    window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
    // Menú mobile
    const burger = document.getElementById('burger'), nav = document.getElementById('nav');
    burger && burger.addEventListener('click', () => { const o = nav.classList.toggle('open'); burger.classList.toggle('open', o); });
    document.querySelectorAll('.nav__item').forEach((item) => {
      const link = item.querySelector('.nav__link'); const dd = item.querySelector('.dropdown');
      if (!dd || !link) return;
      link.addEventListener('click', (e) => { if (window.innerWidth <= 900) { e.preventDefault(); item.classList.toggle('open'); } });
    });
    // Reveal on scroll
    const io = new IntersectionObserver((ents) => { ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }); }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
