---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Branches from '../components/Branches.astro';
import { link } from '../lib/nav';
---
<Base title="Contacto" active="contacto" description="Contactá a MS Patagonia Argentina. Solicitá asesoramiento en bombeo, climatización, aire comprimido y service.">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="breadcrumb"><a href={link('/')}>Inicio</a><span class="sep">/</span><span>Contacto</span></div>
      <span class="kicker">Contacto</span>
      <h1>¿Necesitás asesoramiento?</h1>
      <p>Contanos tu proyecto y un especialista te contactará para asesorarte en la mejor solución.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact">
        <div class="contact__info reveal">
          <span class="kicker">Escribinos</span>
          <h2 class="section-title">Estamos para ayudarte</h2>
          <p class="section-lead">Completá el formulario y nos pondremos en contacto a la brevedad. También podés escribirnos por WhatsApp o visitarnos en cualquiera de nuestras sucursales.</p>
          <div class="contact__feature">
            <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.8 2z"/></svg></div>
            <div><h4>Atención técnica</h4><p>Personal calificado en cada una de nuestras sucursales.</p></div>
          </div>
          <div class="contact__feature">
            <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H5.2L4 17.2z"/></svg></div>
            <div><h4>Respuesta rápida</h4><p>Asesoramiento en bombeo, climatización, aire comprimido y service.</p></div>
          </div>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>

  <Branches />
</Base>
